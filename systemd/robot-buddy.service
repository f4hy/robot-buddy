[Unit]
Description=Robot Buddy
# Not network-online.target: the server listens on all addresses, so it can
# start (and say hello) before Wi-Fi joins.
After=network.target

[Service]
User=robot
WorkingDirectory=/home/robot/robot_buddy
ExecStart=/usr/bin/python3 -m robot
Restart=always
# Port 80 for http://robot without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
